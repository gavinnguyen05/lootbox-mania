# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed into /admin. Create these users in Supabase Auth.
ADMIN_EMAILS=you@example.com

# Discord bot that is a member of the event server
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-server-id

# Optional. Public address used in Discord links, e.g. https://lootbox-mania.vercel.app
# If blank, the address you're using the admin page from is used.
NEXT_PUBLIC_SITE_URL=
